# Copy to .env and fill in. Never commit .env.

# --- Transport: stdio (Claude Desktop, default) or streamable-http (remote hosting) ---
HIRELOOP_TRANSPORT=stdio
HIRELOOP_HOST=127.0.0.1
HIRELOOP_PORT=8000
# Required when serving over HTTP on a non-loopback host (e.g. 0.0.0.0 on App Runner).
# Clients send: Authorization: Bearer <token>. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HIRELOOP_AUTH_TOKEN=

# --- Local storage (your career data stays on your machine) ---
HIRELOOP_DB_PATH=~/.hireloop/hireloop.db

# --- Groq: fast LLM tasks (parsing, drafting, question generation) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional job source: Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# --- Amazon Bedrock (interview grading + embeddings). Falls back to Groq/local if off,
# --- if no AWS credentials are found, or if a Bedrock call fails. Needs: pip install ".[aws]"
USE_BEDROCK=false
AWS_REGION=us-east-1
# A model or inference-profile ID you have been granted access to in the Bedrock console.
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Voice: ElevenLabs interviewer (optional; text mode works without) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# WHISPER_MODEL=whisper-large-v3-turbo
